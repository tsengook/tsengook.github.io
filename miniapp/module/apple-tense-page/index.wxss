.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a, #1e293b);
  color: #e2e8f0;
  padding: 24rpx;
}
.header { margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 700; display:block; }
.subtitle { font-size: 24rpx; color:#94a3b8; display:block; margin-top:8rpx; }

.scoreboard {
  display:flex;
  justify-content: space-between;
  background:#111827;
  border-radius:16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.stage {
  position: relative;
  height: 300rpx;
  border: 2rpx solid #334155;
  border-radius: 20rpx;
  background: radial-gradient(circle at 20% 15%, #334155, #0b1120);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.apple {
  font-size: 90rpx;
  transition: transform 180ms ease-out;
}
.apple-drop { filter: saturate(80%); }
.apple-bounce { filter: brightness(1.2); }
.apple-drop-again { filter: hue-rotate(-15deg); }
.phase-tag {
  position:absolute;
  right:16rpx;
  bottom: 12rpx;
  color:#fbbf24;
  font-size:22rpx;
}

.panel {
  background:#111827;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}
.panel-title { font-size: 28rpx; font-weight:600; margin-bottom: 14rpx; }
.tense-grid {
  display:grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}
.tense-btn {
  background:#312e81;
  color:#fff;
  border:none;
}
.quiz .option-btn {
  margin-bottom: 10rpx;
  text-align:left;
  background:#1f2937;
  color:#e2e8f0;
}
.message {
  margin-top:16rpx;
  background:#0b3b2e;
  border:1rpx solid #10b981;
  border-radius:12rpx;
  padding:12rpx;
  font-size:24rpx;
}
